{
  "name": "aethos-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "npm run preflight && npm run doctor && mocha --timeout 1200000 \"test/**/*.mjs\"",
    "send:wayfarer-media": "npm run preflight && npm run doctor && node scripts/send-wayfarer-media.mjs",
    "inspect:receiver-media": "npm run preflight && npm run doctor && node scripts/inspect-wayfarer-receiver.mjs",
    "playwright:install": "playwright install chromium",
    "test:playwright:browser": "npx playwright test --project=browser-only",
    "test:playwright:tauri": "npx playwright test --project=tauri",
    "test:playwright:headed": "npx playwright test --project=browser-only --headed",
    "test:playwright:report": "npx playwright show-report ../playwright-report",
    "test:playwright:debug": "npx playwright test --project=browser-only --debug"
  },
  "dependencies": {
    "chai": "^5.2.1",
    "mocha": "^11.7.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@srsholmes/tauri-playwright": "^0.2.2"
  }
}
